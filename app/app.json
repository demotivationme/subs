{
  "expo": {
    "name": "Subs",
    "slug": "subs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "subs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alterwave.subs",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.alterwave.subs",
      "adaptiveIcon": {
        "backgroundColor": "#0B7A57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A57",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Subs uses your photos to set an icon for a service you add."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3b7d1b3a-fe2d-477a-93f2-1ca91f20edad"
      }
    },
    "owner": "alter-wave"
  }
}
