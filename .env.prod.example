# Copy to .env (git-ignored) in the repo root; Docker Compose loads it automatically.
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
# Same value as DB_PASSWORD in backend/.env
POSTGRES_PASSWORD=change-me

# Used by docker/bin/backup.sh
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://s3.<region>.io.cloud.ovh.net
